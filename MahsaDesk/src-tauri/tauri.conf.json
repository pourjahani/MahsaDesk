{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MahsaDesk",
  "version": "0.3.5",
  "identifier": "com.mahsadesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:15230",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "MahsaDesk",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mahsadesk"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "binaries/*": "binaries/"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English"]
      }
    }
  }
}
